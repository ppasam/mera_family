# Каталог рабочего профиля браузера (клон профиля клиента).
# Создаётся командой `wishlist profile sync`, живым Chrome не используется.
WISHLIST_BROWSER_PROFILE=~/.local/share/wishlist-buyer/chrome-profile

# Исходный профиль Chrome клиента, с которого снимается клон.
WISHLIST_SOURCE_PROFILE=~/.config/google-chrome/Default

# Показывать окно браузера. Для Ozon держим 1: headless заметно чаще ловит антибот.
WISHLIST_HEADFUL=1

# Каталог журнала действий и скриншотов.
WISHLIST_AUDIT_DIR=~/.local/share/wishlist-buyer/audit

# Файл списка желаний.
WISHLIST_FILE=config/wishlist.yaml
